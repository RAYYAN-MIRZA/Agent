# Copy to .env and fill in values before running docker compose up

# Backend API URL (the agent connects outbound to this)
FYP_AGENT_API_BASE_URL=http://host.docker.internal:5017

# One-time enrollment token (get from backend POST /api/v1/agents/enrollments)
FYP_AGENT_ENROLLMENT_TOKEN=1TpQDSN9nur2xxMMYqkEdUbNBtwTbW0D-s2tUtGF-YQ

# Human-friendly name for this agent
FYP_AGENT_NAME=HomeNetworkAgent

# Discovery settings
FYP_AGENT_DISCOVERY_ENABLED=true
FYP_AGENT_DISCOVERY_INTERVAL=20
# Leave empty to auto-detect from default route
FYP_AGENT_DISCOVERY_CIDR=192.168.100.0/24

# Logging
FYP_AGENT_LOG_LEVEL=INFO

# Set to true when backend uses HTTPS with a valid cert
FYP_AGENT_VERIFY_TLS=false
