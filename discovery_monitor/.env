# discovery_monitor — local settings for this package only.
# Copy from .env.example if you prefer; edit values here.

# Seconds between full ARP sweeps
SCAN_INTERVAL=20

# Seconds between status rounds (re-read ip_mac.json and check each host)
PING_INTERVAL=10

# Concurrent ICMP + ARP fallback workers
PING_WORKERS=50

# ARP probes per batch during subnet sweep
ARP_CONCURRENCY=50

# Workers draining discovery queue (ip_mac writes + nmap enqueue)
DISCOVERY_WORKERS=3

# Parallel nmap processes
NMAP_PARALLEL=3

# Optional: absolute path for JSON output. If unset, uses ./data/ under this folder.
# LAN_AGENT_DATA_DIR=
