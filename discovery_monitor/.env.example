# discovery_monitor — copy to .env and adjust.
# Loaded automatically from discovery_monitor/.env when you run this package.

SCAN_INTERVAL=20
PING_INTERVAL=10
PING_WORKERS=50
ARP_CONCURRENCY=50
DISCOVERY_WORKERS=3
NMAP_PARALLEL=3

# ICMP timeout (ms). Increase on Wi‑Fi (e.g. 1000–1500).
PING_TIMEOUT_MS=750
# Scapy ARP fallback probe (seconds).
ARP_FALLBACK_TIMEOUT=0.6
# Per-host ARP sweep timeout during discovery (seconds).
ARP_SCAN_TIMEOUT=1.0

# Hysteresis: consecutive probe failures before marking offline; successes before online.
OFFLINE_AFTER_FAILS=3
ONLINE_AFTER_OK=1

# Remove inventory rows not seen for this many seconds (0 = never).
DEVICE_STALE_SECONDS=0

# Set false to skip Nmap for fastest discovery-only runs.
NMAP_ENABLED=true

# Optional override for JSON output directory (absolute path recommended on Windows)
# LAN_AGENT_DATA_DIR=
