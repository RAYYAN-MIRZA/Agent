# discovery_monitor — copy to .env and adjust.
# Loaded automatically from discovery_monitor/.env when you run this package.

SCAN_INTERVAL=20
PING_INTERVAL=10
PING_WORKERS=50
ARP_CONCURRENCY=50
DISCOVERY_WORKERS=3
NMAP_PARALLEL=3

# Optional override for JSON output directory (absolute path recommended on Windows)
# LAN_AGENT_DATA_DIR=
